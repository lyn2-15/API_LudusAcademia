SUPABASE_SEED_UID=83c79385-b2dc-47ac-82eb-ffcb92450c1a
SUPABASE_SEED_EMAIL=maestro@test.com
SUPABASE_SEED_ENABLED=true

# Seeding de producción (opcional)
