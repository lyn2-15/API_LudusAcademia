# === LudusAcademia v2 — Variables de entorno ===

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite (ruta al archivo de la BD)
# En desarrollo: archivo local. En producción: volumen persistente en Docker.
DATABASE_PATH=./ludusacademia.db

# Supabase (para validar JWT de docentes)
# Encuéntralos en: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://bbyhevcprqxntsaknwul.supabase.co
SUPABASE_JWT_SECRET=bb98ZyOPgvbnWDRpSWoC6/7ceBL2ZsSjzupNDhpEwrG8XWlEu8mw3sBQUCvEo32FRjxdVX5IIZgi2Ij4mWnisA==

# CORS — separar dominios con comas
ALLOWED_ORIGINS=http://localhost:3000,https://dashboard.ludusacademia.edu.mx

# Límites
MAX_SYNC_PAYLOAD_KB=50
INVITE_CODE_EXPIRY_HOURS=24

# Modo público para endpoints de docentes.
# false = requiere JWT y valida pertenencia del grupo.
# true  = cualquiera puede invocar los endpoints.
ALLOW_PUBLIC_DOCENTE_ENDPOINTS=false

# Datos de prueba para despliegue.
# Solo se cargan si la BD está vacía y esta bandera está en true.
SEED_SAMPLE_DATA=false
